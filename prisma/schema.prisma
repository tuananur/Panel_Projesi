generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int             @id @default(autoincrement())
  username          String          @unique
  password          String?
  role              String          @default("DESIGNER") // "ADMIN", "DESIGNER", "DESIGNER_MANAGER", "ADVERTISER", "ADVERTISER_MANAGER", "DEVELOPER"
  managerId         Int?
  manager           User?           @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  managedUsers      User[]          @relation("UserManager")
  logs              ActivityLog[]
  notes             Note[]          @relation("NoteAssignee")
  createdNotes      Note[]          @relation("NoteCreator")
  assignedWorkItems WorkItem[]      @relation("WorkItemAssignee")
  createdWorkItems  WorkItem[]      @relation("WorkItemCreator")
  approvedWorkItems WorkItem[]      @relation("WorkItemApprover")
  workItemEvents    WorkItemEvent[]
  notifications     Notification[]
  clientGroups      ClientGroup[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([managerId])
}

model Client {
  id          Int     @id @default(autoincrement())
  companyName String
  website     String?
  contactName String
  email       String?
  phone       String?
  services    String // JSON or comma separated e.g. "SEO,SOCIAL_MEDIA"

  // Phase 2 fields
  weeklyBlogTarget    Int?    @default(0)
  socialAccounts      String? @db.Text
  socialSchedule      String? @db.Text
  specialInstructions String? @db.Text
  logoUrl             String? @db.Text

  // Website Integration
  websiteType String? @default("OTHER") // "BEYIN_ATOLYESI", "IDEASOFT", "OTHER"
  blogApiUrl  String? @db.Text
  otoBlogConfig     String? @db.Text
  otoBlogAiSettings String? @db.Text
  otoBlogDraft      String? @db.Text
  otoBlogInboundKey String? @unique
  otoBlogTempImages OtoBlogTempImage[]
  otoBlogAutoJobs   OtoBlogAutoJob[]

  tasks                   Task[]
  logs                    ActivityLog[]
  notes                   Note[]
  workItems               WorkItem[]
  clientGroups            ClientGroup[]
  metaArmyCommands        MetaArmyCommand[]
  metaArmyRuns            MetaArmyRun[]
  metaArmyFindings        MetaArmyFinding[]
  metaArmyRecommendations MetaArmyRecommendation[]
  ubersuggestSnapshots    SeoUbersuggestSnapshot[]
  ubersuggestProjects     SeoUbersuggestProject[]

  // Meta Ads Integration
  metaEnabled     Boolean @default(false)
  metaAdAccountId String? @db.Text
  metaAccessToken String? @db.Text

  // Google Ads Integration
  googleEnabled      Boolean @default(false)
  googleCustomerId   String? @db.Text
  googleRefreshToken String? @db.Text

  // Google Analytics Integration
  analyticsEnabled      Boolean @default(false)
  analyticsPropertyId   String? @db.Text
  analyticsRefreshToken String? @db.Text
  searchConsoleSiteUrl  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaArmyCommand {
  id          Int           @id @default(autoincrement())
  clientId    Int
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  command     String        @db.Text
  status      String        @default("QUEUED") // "QUEUED", "IN_PROGRESS", "COMPLETED", "FAILED", "CANCELLED"
  priority    String        @default("NORMAL") // "LOW", "NORMAL", "HIGH", "URGENT"
  source      String        @default("PANEL")
  requestedBy String?
  result      String?       @db.Text
  runs        MetaArmyRun[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MetaArmyRun {
  id              Int                      @id @default(autoincrement())
  clientId        Int
  client          Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commandId       Int?
  command         MetaArmyCommand?         @relation(fields: [commandId], references: [id], onDelete: SetNull)
  agentName       String
  status          String                   @default("QUEUED") // "QUEUED", "RUNNING", "COMPLETED", "FAILED", "WAITING_APPROVAL"
  summary         String?                  @db.Text
  rawOutput       String?                  @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  findings        MetaArmyFinding[]
  recommendations MetaArmyRecommendation[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model MetaArmyFinding {
  id          Int          @id @default(autoincrement())
  clientId    Int
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runId       Int?
  run         MetaArmyRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  severity    String       @default("INFO") // "INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"
  category    String       @default("PERFORMANCE")
  title       String
  details     String       @db.Text
  evidence    String?      @db.Text
  metricsJson String?      @db.Text
  createdAt   DateTime     @default(now())
}

model MetaArmyRecommendation {
  id             Int          @id @default(autoincrement())
  clientId       Int
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  runId          Int?
  run            MetaArmyRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  actionType     String
  status         String       @default("PENDING_APPROVAL") // "PENDING_APPROVAL", "APPROVED", "REJECTED", "EXECUTED", "FAILED"
  title          String
  details        String       @db.Text
  expectedImpact String?      @db.Text
  riskLevel      String       @default("MEDIUM")
  actionPayload  String?      @db.Text
  approvedBy     String?
  approvalText   String?      @db.Text
  approvedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Task {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime // Date for the post/blog
  type      String // "BLOG" or "SOCIAL"
  platform  String? // Only for social e.g., "Instagram", "YouTube"
  note      String?  @db.Text // Descriptive note for the task
  content   String?  @db.Text // Blog content or body
  link      String?  @db.Text // Link to the specific post
  status    Boolean  @default(false) // false = pending, true = completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   Int?
  client     Client?  @relation(fields: [clientId], references: [id])
  action     String // "CREATE", "UPDATE", "DELETE", "TOGGLE"
  entityType String // "TASK", "CLIENT", "USER", "NOTE"
  details    String   @db.Text
  createdAt  DateTime @default(now())
}

model Note {
  id              Int       @id @default(autoincrement())
  clientId        Int? // Null = Genel Not
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId          Int
  user            User      @relation("NoteAssignee", fields: [userId], references: [id], onDelete: Cascade)
  createdByUserId Int?
  createdByUser   User?     @relation("NoteCreator", fields: [createdByUserId], references: [id])
  title           String?
  content         String    @default("") @db.Text
  category        String    @default("TASK") // "TASK" (iş takibi) | "DEV" (yazılım)
  isDone          Boolean   @default(false)
  remindAt        DateTime?
  reminderSentAt  DateTime?
  reminderUserId  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([reminderUserId, remindAt, reminderSentAt])
}

model WorkItem {
  id          Int       @id @default(autoincrement())
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  priority    String    @default("NORMAL") // "LOW", "NORMAL", "HIGH", "URGENT"
  type        String    @default("OTHER")
  status      String    @default("ASSIGNED") // "ASSIGNED", "IN_PROGRESS", "SUBMITTED", "APPROVED", "REVISION_REQUESTED", "CANCELLED"

  clientId     Int?
  client       Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assigneeId   Int
  assignee     User    @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById  Int
  createdBy    User    @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedById Int?
  approvedBy   User?   @relation("WorkItemApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  submittedAt        DateTime?
  approvedAt         DateTime?
  lastSubmissionNote String?   @db.Text
  lastRevisionNote   String?   @db.Text
  unreadForUserIds   String    @default("[]") @db.Text

  events    WorkItemEvent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([assigneeId, status])
  @@index([createdById, status])
  @@index([clientId])
}

model WorkItemEvent {
  id         Int      @id @default(autoincrement())
  workItemId Int
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // "CREATED", "STARTED", "SUBMITTED", "APPROVED", "REVISION_REQUESTED", "CANCELLED"
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([workItemId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String    @db.Text
  url       String?   @db.Text
  type      String    @default("GENERAL")
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model AccountingEntry {
  id          Int      @id @default(autoincrement())
  type        String // "INCOME" or "EXPENSE"
  amount      Float
  description String
  category    String?
  date        DateTime
  frequency   String   @default("MANUAL") // "MANUAL", "MONTHLY", "QUARTERLY", "YEARLY"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Sabit borç listesi (aylık tekrar yok)
model AccountingDebt {
  id          Int      @id @default(autoincrement())
  description String   @db.Text
  amount      Float?
  note        String?  @db.Text
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Banka kredileri — aylık ödeme giderlere eklenir
model AccountingCredit {
  id              Int       @id @default(autoincrement())
  bankName        String
  totalAmount     Float
  remainingAmount Float
  monthlyPayment  Float
  lastPaidAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Çalışanların müşterilerle açtığı grup takibi
model ClientGroup {
  id        Int      @id @default(autoincrement())
  name      String
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

model MealOrder {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  personCount Int
  cost        Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model OtoBlogAutoJob {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  continueToken String   @unique
  topic         String   @db.Text
  refinedTopic  String?  @db.Text
  title         String?
  status        String   @default("queued")
  statusText    String   @default("Sırada")
  phase         String   @default("queued")
  payloadJson   String?  @db.Text
  logsJson      String   @default("[]") @db.Text
  error         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@map("oto_blog_auto_jobs")
}

model OtoBlogTempImage {
  id        String   @id @default(cuid())
  token     String   @unique
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ============================================================
// Ubersuggest SEO snapshot'ları.
// Tablo adları istenen snake_case biçiminde @@map ile sabitlendi;
// kolonlar proje genelindeki camelCase düzenini korur.
// Metrikler bilinçli olarak nullable: veri gelmezse 0 yazılmaz, null kalır.
// GA4 / Search Console verileriyle hiçbir tablo paylaşılmaz.
// ============================================================

model SeoUbersuggestSnapshot {
  id                   Int      @id @default(autoincrement())
  clientId             Int
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domain               String
  ubersuggestProjectId String?
  snapshotDate         DateTime @db.Date
  source               String   @default("ubersuggest")

  // Domain overview
  organicKeywordsCount    Int?
  estimatedOrganicTraffic Float?
  paidKeywordsCount       Int?
  estimatedPaidTraffic    Float?
  domainAuthority         Int?
  totalBacklinks          Int?
  referringDomains        Int?
  followBacklinks         Int?
  nofollowBacklinks       Int?

  // Site audit summary
  siteHealthScore         Float?
  previousSiteHealthScore Float?
  crawledPagesCount       Int?
  successfulPagesCount    Int?
  redirectedPagesCount    Int?
  brokenPagesCount        Int?
  blockedPagesCount       Int?
  totalIssuesCount        Int?
  auditLastCrawledAt      DateTime?

  // Rank tracking summary
  trackedKeywordsCount   Int?
  keywordsUpCount        Int?
  keywordsDownCount      Int?
  keywordsUnchangedCount Int?
  top3Old                Int?
  top3New                Int?
  top10Old               Int?
  top10New               Int?
  top100Old              Int?
  top100New              Int?
  notRankingOld          Int?
  notRankingNew          Int?

  // SEO opportunity summary
  newContentOpportunityCount      Int?
  existingContentOpportunityCount Int?
  quickWinOpportunityCount        Int?

  // AI search summary
  aiVisibilityPercentage Float?
  aiVisibilityChange     Float?
  aiAverageRank          Float?
  aiAverageRankChange    Float?
  aiTotalMentions        Int?
  aiShareOfVoice         Float?
  aiSentimentScore       Float?
  aiSentimentLabel       String?
  aiTotalAnswers         Int?
  aiTotalPrompts         Int?
  aiTotalCompetitors     Int?

  rawResponseJson Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  domainHistory         SeoUbersuggestDomainHistory[]
  keywords              SeoUbersuggestKeyword[]
  rankTracking          SeoUbersuggestRankTracking[]
  averagePositions      SeoUbersuggestAveragePosition[]
  topPages              SeoUbersuggestTopPage[]
  competitors           SeoUbersuggestCompetitor[]
  backlinks             SeoUbersuggestBacklink[]
  anchorTexts           SeoUbersuggestAnchorText[]
  linkingDomains        SeoUbersuggestLinkingDomain[]
  backlinkOpportunities SeoUbersuggestBacklinkOpportunity[]
  auditIssues           SeoUbersuggestAuditIssue[]
  opportunities         SeoUbersuggestOpportunity[]
  pagespeed             SeoUbersuggestPagespeed[]
  aiProviders           SeoUbersuggestAiProvider[]
  aiCompetitors         SeoUbersuggestAiCompetitor[]
  aiIntents             SeoUbersuggestAiIntent[]

  @@unique([clientId, domain, snapshotDate, source])
  @@index([clientId, snapshotDate])
  @@index([domain])
  @@map("seo_ubersuggest_snapshots")
}

model SeoUbersuggestDomainHistory {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  yearMonth               String
  estimatedOrganicTraffic Float?
  organicKeywordsCount    Int?
  estimatedPaidTraffic    Float?
  paidKeywordsCount       Int?
  topTierKeywords         Int?
  secondTierKeywords      Int?
  thirdTierKeywords       Int?
  fourthTierKeywords      Int?

  @@unique([snapshotId, yearMonth])
  @@index([snapshotId])
  @@map("seo_ubersuggest_domain_history")
}

model SeoUbersuggestKeyword {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  keyword          String
  searchIntent     String?
  currentPosition  Int?
  searchVolume     Int?
  seoDifficulty    Float?
  paidDifficulty   Float?
  competition      Float?
  cpc              Float?
  estimatedTraffic Float?
  rankingUrl       String?
  rankingPath      String?
  positionGroup    String?
  sourceUpdatedAt  DateTime?

  // rankingUrl null olabildiği için Postgres bu kısıtı tek başına yeterli tutmaz;
  // ingest servisi ayrıca aynı anahtarı uygulama tarafında da tekilleştirir.
  @@unique([snapshotId, keyword, rankingUrl])
  @@index([snapshotId])
  @@index([snapshotId, keyword])
  @@map("seo_ubersuggest_keywords")
}

model SeoUbersuggestRankTracking {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  keyword       String
  language      String?
  locationId    String?
  device        String?
  searchVolume  Int?
  seoDifficulty Float?
  competition   Float?

  // null pozisyon = ilk 100'de değil. Sahte 100/101 değeri yazılmaz.
  oldPosition     Int?
  oldPositionDate DateTime?
  oldRankingUrl   String?

  newPosition     Int?
  newPositionDate DateTime?
  newRankingUrl   String?

  positionChange  Int?
  rankingStatus   String?
  isRankingTop100 Boolean?
  isUnstable      Boolean?
  sourceUpdatedAt DateTime?

  @@index([snapshotId])
  @@index([snapshotId, keyword])
  @@map("seo_ubersuggest_rank_tracking")
}

model SeoUbersuggestAveragePosition {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  date            DateTime @db.Date
  averagePosition Float?

  @@unique([snapshotId, date])
  @@index([snapshotId])
  @@map("seo_ubersuggest_average_positions")
}

model SeoUbersuggestTopPage {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  url                     String
  path                    String?
  pageTitle               String?
  estimatedOrganicTraffic Float?
  backlinks               Int?
  referringDomains        Int?
  facebookShares          Int?
  pinterestShares         Int?
  redditShares            Int?

  @@index([snapshotId])
  @@map("seo_ubersuggest_top_pages")
}

model SeoUbersuggestCompetitor {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  competitorDomain                  String
  commonKeywordCount                Int?
  competitorOrganicKeywordsCount    Int?
  keywordGapCount                   Int?
  competitorEstimatedOrganicTraffic Float?
  competitorBacklinks               Int?
  competitorDomainAuthority         Int?

  @@index([snapshotId])
  @@map("seo_ubersuggest_competitors")
}

model SeoUbersuggestBacklink {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  sourceUrl        String
  sourceDomain     String?
  targetUrl        String?
  anchorText       String?
  firstSeen        DateTime?
  lastSeen         DateTime?
  sourceDomainRank Int?
  sourcePageRank   Int?
  backlinkType     String?
  followStatus     String?

  @@index([snapshotId])
  @@index([snapshotId, sourceDomain])
  @@map("seo_ubersuggest_backlinks")
}

model SeoUbersuggestAnchorText {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  anchorText          String
  externalRootDomains Int?
  externalPages       Int?

  @@index([snapshotId])
  @@map("seo_ubersuggest_anchor_texts")
}

model SeoUbersuggestLinkingDomain {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  referringDomain String
  detectedDate    DateTime?
  status          String // "new" | "lost"

  @@index([snapshotId])
  @@index([snapshotId, status])
  @@map("seo_ubersuggest_linking_domains")
}

model SeoUbersuggestBacklinkOpportunity {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  referringDomain   String
  competitorDomain  String?
  ourDomain         String?
  linksToCompetitor Int?
  linksToUs         Int?
  opportunityStatus String?

  @@index([snapshotId])
  @@map("seo_ubersuggest_backlink_opportunities")
}

model SeoUbersuggestAuditIssue {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  issueId       String
  issueCategory String? // "error" | "warning" | "recommendation"
  issueLevel    String? // "domain" | "page"
  issueCount    Int?
  seoImpact     String? // "high" | "medium" | "low"
  difficulty    String? // "easy" | "moderate" | "hard"

  affectedUrls SeoUbersuggestAuditIssueUrl[]

  @@index([snapshotId])
  @@index([snapshotId, issueCategory])
  @@map("seo_ubersuggest_audit_issues")
}

model SeoUbersuggestAuditIssueUrl {
  id           Int                      @id @default(autoincrement())
  auditIssueId Int
  auditIssue   SeoUbersuggestAuditIssue @relation(fields: [auditIssueId], references: [id], onDelete: Cascade)

  url            String
  httpStatus     Int?
  issueStatus    String?
  recommendation String?
  ignored        Boolean?
  diffStatus     String?

  @@index([auditIssueId])
  @@map("seo_ubersuggest_audit_issue_urls")
}

model SeoUbersuggestOpportunity {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  opportunityType    String // "SITE_AUDIT" | "KEYWORD_OPPORTUNITY"
  opportunitySubtype String?

  keyword          String?
  currentPosition  Int?
  searchVolume     Int?
  seoDifficulty    Float?
  paidDifficulty   Float?
  competition      Float?
  cpc              Float?
  rankingUrl       String?
  estimatedTraffic Float?

  impact            String?
  effort            String?
  approved          Boolean?
  opportunityStatus String?

  @@index([snapshotId])
  @@index([snapshotId, opportunityType])
  @@map("seo_ubersuggest_opportunities")
}

model SeoUbersuggestPagespeed {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  device String // "DESKTOP" | "MOBILE"
  status String? // "pending" durumunda metrikler null kalır

  performanceScore    Float?
  seoScore            Float?
  accessibilityScore  Float?
  bestPracticesScore  Float?
  coreWebVitalsStatus String?
  lcp                 Float?
  inp                 Float?
  cls                 Float?
  fcp                 Float?
  ttfb                Float?
  speedIndex          Float?
  checkedAt           DateTime?

  @@unique([snapshotId, device])
  @@index([snapshotId])
  @@map("seo_ubersuggest_pagespeed")
}

model SeoUbersuggestAiProvider {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  provider String // "openai" | "gemini" | "google_aio"

  visibilityPercentage Float?
  visibilityChange     Float?
  averageRank          Float?
  averageRankChange    Float?
  totalMentions        Int?
  sentimentScore       Float?
  sentimentLabel       String?

  positiveKeywordsJson Json?
  negativeKeywordsJson Json?

  @@unique([snapshotId, provider])
  @@index([snapshotId])
  @@map("seo_ubersuggest_ai_providers")
}

model SeoUbersuggestAiCompetitor {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  brandName   String
  isUserBrand Boolean?
  isTracked   Boolean?
  isPinned    Boolean?

  averageRank                 Float?
  totalMentions               Int?
  visibilityPercentage        Float?
  sentimentScore              Float?
  sentimentPositivePercentage Float?
  sentimentNegativePercentage Float?
  sentimentNeutralPercentage  Float?
  sentimentLabel              String?

  @@index([snapshotId])
  @@map("seo_ubersuggest_ai_competitors")
}

model SeoUbersuggestAiIntent {
  id         Int                    @id @default(autoincrement())
  snapshotId Int
  snapshot   SeoUbersuggestSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  informationalCount Int?
  navigationalCount  Int?
  commercialCount    Int?
  transactionalCount Int?

  @@index([snapshotId])
  @@map("seo_ubersuggest_ai_intents")
}

model SeoUbersuggestProject {
  id                   Int     @id @default(autoincrement())
  clientId             Int
  client               Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ubersuggestProjectId String
  domain               String
  projectTitle         String?
  projectStatus        String?
  projectType          String?
  updateFrequency      String?

  mobileRankTrackingEnabled Boolean?
  pixelRankTrackingEnabled  Boolean?
  alertsEnabled             Boolean?
  hasAiBrandTracking        Boolean?

  trackedKeywordCount    Int?
  trackedCompetitorCount Int?
  trackedLocationCount   Int?

  keywordsLastUpdatedAt     DateTime?
  auditLastUpdatedAt        DateTime?
  trafficValueLastUpdatedAt DateTime?

  keywordLimit    Int?
  keywordUsed     Int?
  competitorLimit Int?
  competitorUsed  Int?
  locationLimit   Int?
  locationUsed    Int?
  aiPromptLimit   Int?
  aiPromptUsed    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations   SeoUbersuggestProjectLocation[]
  competitors SeoUbersuggestProjectCompetitor[]

  @@unique([clientId, ubersuggestProjectId])
  @@index([clientId])
  @@map("seo_ubersuggest_projects")
}

model SeoUbersuggestProjectLocation {
  id        Int                   @id @default(autoincrement())
  projectId Int
  project   SeoUbersuggestProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  language   String?
  locationId String?

  @@index([projectId])
  @@map("seo_ubersuggest_project_locations")
}

model SeoUbersuggestProjectCompetitor {
  id        Int                   @id @default(autoincrement())
  projectId Int
  project   SeoUbersuggestProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  competitorDomain String
  language         String?
  locationId       String?

  @@index([projectId])
  @@map("seo_ubersuggest_project_competitors")
}
